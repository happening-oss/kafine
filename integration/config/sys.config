[
    {kernel, [
        {logger_level, notice},

        {logger, [
            {module_level, none, [application_controller, supervisor_bridge, supervisor]},
            % {module_level, info, [kafine_connection]},
            % {module_level, debug, [kafine_consumer, kafine_node_consumer]},

            % {handler, default, logger_std_h, #{formatter => {logger_formatter, #{}}}}
            {handler, default, logger_std_h, #{
                formatter =>
                    {logger_color_formatter, #{
                        template => [
                            color, time, " ",
                            "[", level, "]",
                            {pid, [" ", pid, ""], ""},
                            {ref, [" ref=", ref], ""},
                            {group_id, [" group_id=", group_id], ""},
                            {member_id, [" member_id=", member_id], ""},
                            {node_id, [" node_id=", node_id], ""},
                            {topic, [" topic=", topic], ""},
                            {partition, [" partition=", partition], ""},
                            {mfa, [" ", mfa, ":", line], ""},
                            ": ",
                            msg, reset, "\n"
                        ],
                        chars_limit => 2000,
                        depth => 20,
                        single_line => false
                    }}
            }}
        ]}
    ]},

    {ct_ext, [
        {elapsed_thresholds, [
            {10_000, "\e[0;31m"},
            {5_000, "\e[0;33m"},
            {0, "\e[0;90m"}
        ]}
    ]}
].
